# Copy to .env; keep credentials and keys outside version control.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapppinger
# Neon: require or verify-full. Local disposable PostgreSQL: disable.
DB_SSL_MODE=disable
# One of vps1, vps2, local. PostgreSQL owns account-to-host binding.
HOST_LABEL=local
# Provision the same EXISTING key on all three hosts. Never rotate it here.
# IDENTITY_SECRET_PATH=/protected/location/identity.secret
# Alternative: IDENTITY_HMAC_SECRET supplied through the process environment.
# A reviewed build identifier is recommended for reproducible deployment.
# BUILD_ID=reviewed-build-identifier
LEASE_TTL_MS=120000
HEARTBEAT_INTERVAL_MS=30000
SYNC_INTERVAL_MS=15000
# Optional network-classification service token.
IPINFO_TOKEN=
