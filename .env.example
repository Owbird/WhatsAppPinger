# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Connection string for the study database. Plain Postgres; no ORM.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapppinger

# Single TLS toggle: require (managed Postgres) | disable (local, no TLS) |
# verify-ca | verify-full.
DB_SSL_MODE=disable

# Stable label for the physical host this process runs on. One of: vps, local.
# The same two machines are used for every arm.
HOST_LABEL=local

# Gap handling thresholds (ms). A call this far past its slot is a gap; past
# the second, the run is marked interrupted. Change here only.
FLAG_THRESHOLD_MS=10000
INVALIDATE_THRESHOLD_MS=60000

# Lease/heartbeat timing.
LEASE_TTL_MS=120000
HEARTBEAT_INTERVAL_MS=30000
SYNC_INTERVAL_MS=15000

# Sink chat for the messaging arm. One chat, shared by both messaging hosts.
SINK_CHAT_ID=

# Optional ipinfo.io token (raises the rate limit; the hosting flag needs a
# paid plan, in which case the service's own classification is used and the
# built-in ASN list is the fallback).
IPINFO_TOKEN=
